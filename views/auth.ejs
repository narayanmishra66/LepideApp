<%- include('partials/head') %>
<% const signup = page === 'signup'; const recovery = page === 'forgot-password'; const reset = page === 'reset-password'; const submitLabel = signup ? 'Create workspace' : recovery ? 'Send recovery email' : reset ? 'Update password' : 'Log in to your workspace'; %>
<div class="auth-page">
  <aside class="auth-story" aria-label="A clearer view of your security">
    <div class="auth-brand"><%- include('partials/brand') %><span class="eyebrow">A LITTLE CLARITY GOES A LONG WAY.</span></div>
    <div class="story-content"><span class="lp-badge lp-badge--default"><span class="lp-badge__dot"></span>Your security, in perspective</span><h2>Big picture.<br>Small details.<br><span>All under control.</span></h2><p>A calmer way to manage your data,<br>protect your people, and move forward.</p>
      <div class="security-illustration" aria-hidden="true"><div class="orbit orbit-outer"></div><div class="orbit orbit-inner"></div><div class="shield-center"><%- include('partials/icon', { name: 'shield' }) %></div><span class="orbit-node node-data"><%- include('partials/icon', { name: 'layers' }) %></span><span class="orbit-node node-users"><%- include('partials/icon', { name: 'users' }) %></span><span class="orbit-node node-lock"><%- include('partials/icon', { name: 'lock' }) %></span><span class="orbit-node node-file"><%- include('partials/icon', { name: 'file' }) %></span><div class="illustration-label"><span class="lp-badge lp-badge--success"><span class="lp-badge__dot"></span>Connected. Protected. Clear.</span></div></div>
      <div class="story-benefits"><span><%- include('partials/icon', { name: 'check' }) %>One connected workspace</span><span><%- include('partials/icon', { name: 'check' }) %>Designed around your team</span><span><%- include('partials/icon', { name: 'check' }) %>Clarity, without the complexity</span></div>
    </div><div class="story-footer"><span>Clarity. Control. Confidence.</span><span><%- include('partials/icon', { name: 'shield' }) %> Thoughtful by design</span></div>
  </aside>
  <div class="auth-main">
    <header class="auth-top"><div class="mobile-brand"><%- include('partials/brand') %></div><a class="lp-link lp-link--standalone" href="/"><span aria-hidden="true">←</span> Back to home</a><button class="lp-button lp-button--secondary lp-button--sm" type="button" data-theme-cycle aria-label="Color theme: light. Switch to dark"><%- include('partials/icon', { name: 'sun' }) %><span class="theme-label">Light</span></button></header>
    <main class="auth-form-region" id="main"><div class="auth-form-content"><span class="form-emblem"><%- include('partials/icon', { name: signup ? 'sparkle' : 'shield' }) %></span><span class="eyebrow"><%= signup ? 'A FRESH START. A CLEARER VIEW.' : 'YOUR ACCOUNT. UNDER CONTROL.' %></span><h1><%= title %><span class="brand-period">.</span></h1><p class="auth-intro"><%= signup ? 'A little setup. A lot more peace of mind.' : recovery ? 'We’ll send a link to help you get back in.' : reset ? 'Choose a strong password you haven’t used before.' : 'A clearer view of your security is one sign-in away.' %></p>
      <% if (errors.form) { %><div class="lp-message lp-message--error" role="alert"><span class="lp-message__icon"><%- include('partials/icon', { name: 'shield' }) %></span><div class="lp-message__content"><div class="lp-message__text"><h2 class="lp-message__title">Let’s try that again</h2><p class="lp-message__body"><%= errors.form %></p></div></div></div><% } %>
      <form class="auth-form" method="post" action="/<%= page %>" data-auth-form novalidate>
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <% if (signup) { %><%- include('partials/field', { id: 'name', label: 'Full name', type: 'text', placeholder: 'Alex Morgan', autocomplete: 'name' }) %><%- include('partials/field', { id: 'company', label: 'Company name', type: 'text', placeholder: 'Your company', autocomplete: 'organization' }) %><% } %>
        <% if (!reset) { %><%- include('partials/field', { id: 'email', label: 'Work email', type: 'email', placeholder: 'you@company.com', autocomplete: 'email' }) %><% } %>
        <% if (!recovery) { %><%- include('partials/field', { id: 'password', label: reset ? 'New password' : 'Password', type: 'password', placeholder: signup || reset ? 'Create a strong password' : 'Enter your password', autocomplete: signup || reset ? 'new-password' : 'current-password' }) %>
        <div class="password-options"><label class="lp-checkbox"><span class="lp-checkbox__control"><input class="lp-checkbox__input" type="checkbox" data-show-password><span class="lp-checkbox__box" aria-hidden="true"><svg class="lp-checkbox__check" viewBox="0 0 10 8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M1 4.2 3.8 7 9 1"/></svg><svg class="lp-checkbox__dash" viewBox="0 0 10 2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M1 1h8"/></svg></span></span><span class="lp-checkbox__label">Show password</span></label></div>
        <% } %>
        <% if (signup) { %><div><label class="lp-checkbox"><span class="lp-checkbox__control"><input class="lp-checkbox__input" type="checkbox" name="terms" id="terms" required aria-invalid="<%= errors.terms ? 'true' : 'false' %>" aria-describedby="terms-message"><span class="lp-checkbox__box<%= errors.terms ? ' lp-checkbox__box--error' : '' %>" aria-hidden="true"><svg class="lp-checkbox__check" viewBox="0 0 10 8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M1 4.2 3.8 7 9 1"/></svg><svg class="lp-checkbox__dash" viewBox="0 0 10 2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M1 1h8"/></svg></span></span><span class="lp-checkbox__label">I agree to the terms and privacy notice.</span></label><div class="lp-input__message lp-input__message--error" id="terms-message" <%= errors.terms ? '' : 'hidden' %>><%= errors.terms || '' %></div><button class="lp-button lp-button--secondary lp-button--sm" type="button" data-lp-modal-open="privacy-modal">Read terms</button></div>
        <% } else if (!recovery && !reset) { %><div class="form-options"><label class="lp-checkbox"><span class="lp-checkbox__control"><input class="lp-checkbox__input" name="remember" type="checkbox"><span class="lp-checkbox__box" aria-hidden="true"><svg class="lp-checkbox__check" viewBox="0 0 10 8" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M1 4.2 3.8 7 9 1"/></svg><svg class="lp-checkbox__dash" viewBox="0 0 10 2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M1 1h8"/></svg></span></span><span class="lp-checkbox__label">Remember me for 7 days</span></label><a class="lp-link lp-link--inline" href="/forgot-password">Forgot password?</a></div><% } %>
        <button class="lp-button lp-button--primary lp-button--md lp-button--full-width" type="submit" data-submit><span data-submit-label><%= submitLabel %></span><span class="lp-button__icon-right"><%- include('partials/icon', { name: 'arrow' }) %></span></button>
        <p class="form-error-summary" role="alert" data-form-summary hidden></p>
      </form>
      <div class="auth-switch"><%= signup ? 'Already have an account?' : 'New to Lepidus?' %> <a class="lp-link lp-link--inline" href="/<%= signup ? 'login' : 'signup' %>"><%= signup ? 'Log in' : 'Create a workspace' %> <span aria-hidden="true">→</span></a></div>
      <div class="auth-safety"><%- include('partials/icon', { name: 'lock' }) %><span>Your account is stored in our database.<br>Passwords are protected with salted hashes.</span></div>
    </div></main>
    <footer class="auth-footer"><span>© <%= year %> Lepidus</span><button class="lp-button lp-button--secondary lp-button--sm" type="button" data-lp-modal-open="privacy-modal">Privacy & terms</button></footer>
  </div>
</div>
<%- include('partials/legal') %>
</body></html>
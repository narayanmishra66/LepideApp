<%- include('partials/head') %><%- include('partials/header') %>
<main id="main" class="workspace-main"><div class="container"><div class="workspace-welcome"><div><span class="eyebrow">YOUR NEXT CHAPTER</span><h1>Welcome, <%= user.name.split(' ')[0] %><span class="brand-period">.</span></h1><p>Welcome to your workspace preview for <%= user.company %>.</p></div><form action="/logout" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="lp-button lp-button--secondary lp-button--md" type="submit">Log out <span class="lp-button__icon-right"><%- include('partials/icon', { name: 'logout' }) %></span></button></form></div><div class="lp-message lp-message--success" role="status"><span class="lp-message__icon"><%- include('partials/icon', { name: 'check' }) %></span><div class="lp-message__content"><div class="lp-message__text"><h2 class="lp-message__title">You’re all set</h2><p class="lp-message__body">Signed in as <%= user.email %> using your database account. The product overview below still uses sample data.</p></div></div></div><div class="workspace-preview"><%- include('partials/overview') %></div><div class="workspace-disclaimer"><%- include('partials/icon', { name: 'lock' }) %><p>Your account is stored in the private app_users database table. Company details do not grant team membership or access roles.</p></div></div></main>
<%- include('partials/footer') %>
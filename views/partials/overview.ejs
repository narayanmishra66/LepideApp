<section class="lp-card lp-card--elevated" aria-label="Illustrative security workspace preview">
  <div class="lp-card__header"><div class="preview-heading"><span class="preview-mark"><%- include('icon', { name: 'grid' }) %></span><h2 class="lp-card__title">Security overview</h2></div><span class="lp-badge lp-badge--success"><span class="lp-badge__dot"></span>All systems healthy</span></div>
  <div class="lp-card__body">
    <div class="preview-context"><span>Acme workspace <span class="muted">/ Overview</span></span><span class="sample-label">Sample data</span></div>
    <div class="overview-summary"><div><span class="eyebrow">YOUR SECURITY POSTURE</span><div class="score-line"><strong>98<span class="muted">/100</span></strong><span class="lp-badge lp-badge--success">↑ 12 points</span></div><p class="small-copy">Looking good. Your data is in a safer place.</p></div><div class="posture-seal"><%- include('icon', { name: 'shield' }) %></div></div>
    <div class="overview-stats"><div><%- include('icon', { name: 'layers' }) %><strong>12,486</strong><span>Assets monitored</span></div><div><%- include('icon', { name: 'users' }) %><strong>2,048</strong><span>Identities protected</span></div><div><%- include('icon', { name: 'shield' }) %><strong>99.9%</strong><span>Coverage</span></div></div>
    <div class="activity-heading"><strong>Recent activity</strong><span class="small-copy">Last 24 hours</span></div>
    <div class="activity-list"><div class="activity-entry"><span class="activity-icon"><%- include('icon', { name: 'shield' }) %></span><div><strong>All sensitive data accounted for</strong><span>Discovery scan completed successfully</span></div><span class="small-copy">2m ago</span></div><div class="activity-entry"><span class="activity-icon"><%- include('icon', { name: 'users' }) %></span><div><strong>Permissions reviewed</strong><span>12 overprivileged accounts identified</span></div><span class="small-copy">18m ago</span></div><div class="activity-entry"><span class="activity-icon"><%- include('icon', { name: 'file' }) %></span><div><strong>Compliance report ready</strong><span>Your weekly summary is good to go</span></div><span class="small-copy">1h ago</span></div></div>
  </div>
  <div class="lp-card__footer"><span class="small-copy"><%- include('icon', { name: 'lock' }) %> One clear view. Complete peace of mind.</span><span class="live-indicator">Demo preview</span></div>
</section>
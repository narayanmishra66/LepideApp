{
  "name": "lepidus-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Token-driven Lepidus home and authentication pages, built with Node.js and Bootstrap grid.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "assets": "node --use-system-ca scripts/download-assets.js",
    "db:init": "node --use-system-ca scripts/init-db.js",
    "start": "node --use-system-ca server.js",
    "dev": "node --use-system-ca --watch server.js",
    "test": "node --test",
    "check": "node --check server.js && node --check app.js && node --check public/js/app.js"
  },
  "dependencies": {
    "@fontsource/open-sans": "^5.2.5",
    "bootstrap": "^5.3.8",
    "connect-pg-simple": "^10.0.0",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.0",
    "supertest": "^7.1.4"
  }
}
